{
	"name": "n8n-nodes-accessexl",
	"version": "0.1.0",
	"description": "n8n node for AccessEXL: update inputs, run scenarios and read or write table rows in your Excel workbooks through a controlled API.",
	"license": "MIT",
	"homepage": "https://accessexl.accessanalytic.com.au",
	"keywords": [
		"n8n-community-node-package",
		"accessexl",
		"excel"
	],
	"author": {
		"name": "Access Analytic",
		"email": "jrobson@accessanalytic.com.au"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jrobsonaccessanalytic/n8n-nodes-accessexl.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"test": "n8n-node build && node --test test/fields.test.mjs test/node.test.mjs",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AccessExlApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/AccessExl/AccessExl.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^22.0.0",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
